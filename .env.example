# Скопируйте этот файл в .env и заполните.

# Токен бота от @BotFather (обязателен: им проверяется вход игроков)
BOT_TOKEN=1234567890:AAAA-ваш-токен

# Публичный HTTPS-адрес, где открыт сайт (тот же, что вы укажете в BotFather)
WEBAPP_URL=https://your-app.example.com

# Telegram ID админов через запятую (узнать свой ID: бот @userinfobot)
ADMIN_IDS=123456789

# Порт сервера (хостинги обычно задают его сами)
PORT=3000

# Адрес, на котором слушает сервер. На своём VPS за Caddy ставьте 127.0.0.1
# HOST=127.0.0.1

# PostgreSQL (необязательно). Если не задан — данные хранятся во встроенной SQLite в файле data.sqlite.
# Для Postgres также выполните: npm install pg
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Текст кнопки в боте
BUTTON_TEXT=Играть

# ТОЛЬКО для проверки на своём компьютере без Telegram: все запросы идут от этого игрока.
# На боевом сервере оставьте пустым!
# DEV_USER=dev
